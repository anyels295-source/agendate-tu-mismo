// Modelo de datos de Agendate Tú Mismo (MVP)
// Diseñado para arrancar con un único profesional piloto y escalar a multi-tenant
// sin romper el esquema (professionalId ya está presente en todo lo relevante).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  TEAMS
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

model Professional {
  id                String   @id @default(cuid())
  // Email del admin dueño de esta cuenta (puede tener varios profesionales/
  // integrantes del equipo, todos gestionados con el mismo login de /admin).
  ownerEmail        String   @default("")
  slug              String   @unique
  name              String
  email             String   @unique
  phone             String?
  timezone          String   @default("America/Montevideo")
  serviceName       String   @default("Consulta")
  durationMinutes   Int      @default(30)
  bufferMinutes     Int      @default(0)
  workingHours      Json
  minNoticeHours    Int      @default(2)
  maxAdvanceDays    Int      @default(30)
  bookingCalendarId String?
  active            Boolean  @default(true)
  // Canales de notificación habilitados para los turnos de este profesional.
  notifyWhatsapp    Boolean  @default(true)
  notifyEmail       Boolean  @default(true)
  notifyTeams       Boolean  @default(false)
  teamsWebhookUrl   String?
  // Foto de perfil como data URL (base64), comprimida en el cliente antes de
  // subirla — no hay almacenamiento de archivos/blob en este MVP, así que
  // guardarla como texto en la propia fila es la opción sin infraestructura
  // extra. "claro" es el tema por defecto (ver Configuración → Apariencia).
  photoUrl          String?
  theme             String   @default("claro")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  calendarConnections CalendarConnection[]
  bookings            Booking[]
  services            Service[]

  @@index([ownerEmail])
}

model Service {
  id              String   @id @default(cuid())
  professionalId  String
  professional    Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int      @default(30)
  // Precio como texto libre ("$650", "US$ 20", etc.) para no atar el MVP a
  // una moneda o formato particular; es solo informativo, no afecta el cobro.
  price           String?
  active          Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings Booking[]

  @@index([professionalId])
}

model CalendarConnection {
  id                 String           @id @default(cuid())
  professionalId     String
  professional       Professional     @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  provider           CalendarProvider
  accountEmail       String
  externalCalendarId String           @default("primary")
  accessTokenEnc     String
  refreshTokenEnc    String
  expiresAt          DateTime
  // Se pone en `false` cuando el refresh token queda inválido (revocado o
  // vencido más allá de lo renovable) — ver tokenManager.ts, que ya
  // escribía este campo pero nunca se había agregado al schema, lo que
  // rompía la build (route.ts de availability lo usa para no contar una
  // conexión rota como "calendario disponible"). Default true: todas las
  // conexiones existentes se consideran activas al migrar.
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([professionalId, provider, accountEmail])
}

// OJO: además de lo que se ve acá, la tabla tiene una restricción de exclusión
// ("Booking_no_overlap", migración 20261002140000_booking_no_overlap) que impide
// dos turnos Pendiente/Confirmado solapados del mismo profesional. Prisma no la
// puede expresar, pero la respeta: un conflicto llega como error 23P01.
model Booking {
  id               String            @id @default(cuid())
  professionalId   String
  professional     Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  serviceId        String?
  service          Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  clientName       String
  // El email pasó a ser el dato de contacto obligatorio (se exige en el
  // formulario/API, no acá) porque siempre hace falta un canal de contacto
  // confiable; WhatsApp quedó opcional — si el cliente lo completa, además
  // se le avisa por ahí. clientPhone se afloja a nullable en vez de
  // clientEmail pasar a NOT NULL porque ya existen reservas reales (y datos
  // de demo) con email vacío: forzar NOT NULL ahí rompería la migración o
  // corrompería datos históricos con un valor inventado. Ver
  // agendate_ideas_originales_gap_analysis en memoria del proyecto, pedido
  // el 2026-08-24.
  clientEmail      String?
  clientPhone      String?
  startTime        DateTime
  endTime          DateTime
  status           BookingStatus     @default(PENDING)
  notes            String?
  calendarProvider CalendarProvider?
  externalEventId  String?
  cancelToken      String            @unique @default(uuid())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  notifications NotificationLog[]

  @@index([professionalId, startTime])
}

/// Contadores del límite de peticiones (ver src/lib/rateLimit.ts). Una fila por identificador y ventana de tiempo.
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}

model NotificationLog {
  id        String              @id @default(cuid())
  bookingId String
  booking   Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  status    NotificationStatus
  error     String?
  sentAt    DateTime            @default(now())
}
