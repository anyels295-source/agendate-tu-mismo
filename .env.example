# --- Base de datos ---
# Para desarrollo/piloto rápido: usar SQLite (comentar la línea de PostgreSQL en prisma/schema.prisma)
# DATABASE_URL="file:./dev.db"
# Para producción: PostgreSQL (ej. Neon, Supabase, RDS)
DATABASE_URL="postgresql://usuario:password@localhost:5432/agendate?schema=public"

# --- Seguridad ---
# Clave para firmar sesiones de admin (generar con: openssl rand -base64 32)
AUTH_SECRET="reemplazar-con-una-clave-larga-y-aleatoria"
# Clave para cifrar los tokens de calendario guardados en la base (32 bytes en base64: openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY="reemplazar-con-otra-clave-de-32-bytes-en-base64"

# URL pública de la app (usada para construir los callback de OAuth)
APP_URL="http://localhost:3000"

# --- Google Calendar (Google Cloud Console > APIs & Services > Credentials) ---
# 1. Crear proyecto en https://console.cloud.google.com/
# 2. Habilitar "Google Calendar API"
# 3. Crear credencial OAuth 2.0 (tipo Web application)
# 4. Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Microsoft / Outlook (Azure Portal > App registrations) ---
# 1. Registrar app en https://portal.azure.com/ (Azure Active Directory > App registrations)
# 2. Tipo de cuenta: "Cuentas en cualquier organización y personales de Microsoft"
# 3. Redirect URI (Web): {APP_URL}/api/auth/outlook/callback
# 4. Permisos de API (delegados): Calendars.ReadWrite, offline_access, User.Read
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"

# --- WhatsApp Business Cloud API (Meta for Developers) ---
# 1. Crear app en https://developers.facebook.com/ (tipo "Business")
# 2. Agregar el producto "WhatsApp"
# 3. Obtener un token permanente (System User) y el Phone Number ID
# 4. Crear y aprobar la plantilla de mensaje "confirmacion_turno" (ver docs/whatsapp-template.md)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME="confirmacion_turno"
WHATSAPP_API_VERSION="v20.0"
# Token propio (lo inventás vos) para que Meta verifique el webhook al configurarlo.
WHATSAPP_WEBHOOK_VERIFY_TOKEN="reemplazar-con-una-palabra-clave-propia"

# --- Email de respaldo (Resend, API HTTP simple) ---
# Crear cuenta en https://resend.com/, verificar el dominio y generar un API key.
RESEND_API_KEY=""
SMTP_FROM="Agendate Tú Mismo <no-responder@tudominio.com>"

# --- Admin del piloto (MVP de un solo tenant/profesional) ---
# Usuario y contraseña temporales para entrar al panel /admin mientras no hay
# múltiples profesionales. Reemplazar por un modelo de usuarios antes de escalar.
ADMIN_EMAIL="ibermudez@invenzis.com"
ADMIN_PASSWORD_HASH=""
